{
  "name": "scribe",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only capture of coding-agent conversations into one canonical, redacted archive",
  "license": "MIT",
  "type": "module",
  "bin": {
    "scribe": "scripts/bin/scribe.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "conversations:doctor": "tsx scripts/bin/run-conversations-doctor.ts",
    "conversations:export": "tsx scripts/bin/run-conversations-export.ts",
    "conversations:capture": "tsx scripts/bin/run-conversations-capture.ts",
    "conversations:migrate-segments": "tsx scripts/bin/run-conversations-migrate-segments.ts",
    "conversations:verify-segments": "tsx scripts/bin/run-conversations-verify-segments.ts",
    "conversations:benchmark-segments": "tsx scripts/bin/run-conversations-benchmark-segments.ts",
    "conversations:import": "tsx scripts/bin/run-conversations-import.ts",
    "conversations:rewrite": "tsx scripts/bin/run-conversations-rewrite.ts",
    "conversations:render": "tsx scripts/bin/run-conversations-render.ts",
    "contract:fixture": "tsx scripts/bin/run-archive-contract-fixture.ts",
    "conversations:test": "tsx --test \"scripts/**/*_TEST.ts\"",
    "scribe": "tsx scripts/bin/scribe.ts",
    "test": "pnpm run conversations:test",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "pnpm run type-check && pnpm run format:check && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@syntopica/prettier-config": "^0.2.2",
    "@syntopica/tsconfig": "^0.3.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-code-policy": "^0.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
